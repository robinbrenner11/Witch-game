[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/ui/menu_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings_menu.tscn" id="3_settings"]

[node name="PauseMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.054902, 0.039216, 0.0784314, 0.6)

[node name="Scaled" type="Control" parent="."]
anchors_preset = 0
offset_right = 320.0
offset_bottom = 180.0
scale = Vector2(2, 2)
mouse_filter = 2

[node name="Menu" type="CenterContainer" parent="Scaled"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Scaled/Menu"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Scaled/Menu/Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Scaled/Menu/Panel/Box"]
layout_mode = 2
text = "Pause"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Scaled/Menu/Panel/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Fortsetzen"

[node name="SettingsButton" type="Button" parent="Scaled/Menu/Panel/Box"]
layout_mode = 2
text = "Einstellungen"

[node name="SaveQuitButton" type="Button" parent="Scaled/Menu/Panel/Box"]
layout_mode = 2
text = "Speichern und beenden"

[node name="SettingsMenu" parent="." instance=ExtResource("3_settings")]
layout_mode = 1

[connection signal="pressed" from="Scaled/Menu/Panel/Box/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Scaled/Menu/Panel/Box/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Scaled/Menu/Panel/Box/SaveQuitButton" to="." method="_on_save_quit_button_pressed"]
